{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureSource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "media_kinds", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "media_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["image", "video"]}
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
