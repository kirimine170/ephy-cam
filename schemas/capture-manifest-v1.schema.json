{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_kind",
    "identity",
    "identity_basis",
    "capture_id",
    "source_id",
    "envelope_version",
    "bindings",
    "capture_time",
    "metrology_eligible",
    "physical_validation",
    "adopted"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "bundle_kind": {
      "const": "offline_inspection_observation"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "task_id",
        "sample_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sample_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "identity_basis": {
      "const": "operator_assertion"
    },
    "capture_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_id": {
      "type": "string"
    },
    "envelope_version": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "image",
        "envelope",
        "validation"
      ],
      "properties": {
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          }
        }
      }
    },
    "capture_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "meaning",
        "exposure_time"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "meaning": {
          "enum": [
            "host_artifact_write_after_jpeg_receive",
            "envelope_declared_time_unverified"
          ]
        },
        "exposure_time": {
          "const": "unknown"
        }
      }
    },
    "metrology_eligible": {
      "const": false
    },
    "physical_validation": {
      "const": "not_performed"
    },
    "adopted": {
      "const": false
    }
  }
}
